{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run build",
    "outputDirectory": "dist/public",
    "installCommand": "npm install",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://creatorflow-api.onrender.com/api/:path*"
        },
        {
            "source": "/auth/:path*",
            "destination": "https://creatorflow-api.onrender.com/auth/:path*"
        }
    ]
}